# Application settings
APP_NAME=Recipe Hub Backend
APP_VERSION=0.1.0
APP_DESCRIPTION=Provides recipe data, user management, and API endpoints for the frontend.

# Database configuration
# For Postgres: postgresql+psycopg2://user:pass@host:5432/dbname
# For MySQL: mysql+pymysql://user:pass@host:3306/dbname
DATABASE_URL=sqlite:///./data.db

# Security
SECRET_KEY=please-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
