# Backend environment example for Recipe Hub

# Database configuration
DATABASE_URL=sqlite:///./data.db

# Security (set a strong key in production)
SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# CORS
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Perplexity integration (optional for /recommend-title and /chatbot)
# If PERPLEXITY_API_KEY is set, the backend will use Perplexity. Otherwise, it falls back to heuristics.
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
PERPLEXITY_MAX_TOKENS=120
PERPLEXITY_TEMPERATURE=0.2
