# Recipe Hub Backend - Example .env (Development)
# Copy this file to ".env" in the same directory and adjust values as needed.

# --- Application metadata ---
APP_NAME="Recipe Hub Backend"
APP_VERSION="0.1.0"
APP_DESCRIPTION="Provides recipe data, user management, and API endpoints for the frontend."

# --- Database configuration ---
# For local development, use SQLite with a file in the project directory.
# SQLAlchemy URLs: https://docs.sqlalchemy.org/en/20/core/engines.html
DATABASE_URL="sqlite:///./data.db"

# --- Security / JWT ---
# IMPORTANT: Use a strong random value in production.
SECRET_KEY="dev-insecure-change-me"
# Token expiration in minutes (e.g., 60 = 1 hour)
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Signing algorithm for JWT
ALGORITHM="HS256"

# --- CORS (comma separated lists allowed; use `*` for all) ---
CORS_ALLOW_ORIGINS="*"
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS="*"
CORS_ALLOW_HEADERS="*"
