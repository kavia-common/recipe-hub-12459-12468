# Database
DATABASE_URL=sqlite:///./data.db

# Security
SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# CORS
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Perplexity API (backend-only; do NOT expose to frontend)
# Obtain your API key from Perplexity and set it here in production environments.
PERPLEXITY_API_KEY=
# Optional tuning
PERPLEXITY_MODEL=sonar
PERPLEXITY_MAX_TOKENS=512
PERPLEXITY_TEMPERATURE=0.2
